# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Scratch e artefatti locali
/scratch/
/tmp/
*.log

# Artefatti di build del prodotto
/target/
# ⛔ /Cargo.lock NON si ignora, ed è deliberato: gate-deps.sh verifica il grafo
# TRANSITIVO delle dipendenze contro l'allow-list di ADR-0031. Senza lockfile versionato
# il grafo si risolve diverso su un'altra macchina o un altro giorno, e il controllo
# misurerebbe un grafo che nessuno ha approvato. Gli spike qui sotto ignorano il proprio
# perché sono prove usa-e-getta; questo è il prodotto.

# Artefatti di build degli spike — le prove si conservano, i binari no
/spikes/rust/target/
/spikes/rust/Cargo.lock
/spikes/gui-ipc/target/
/spikes/gui-ipc/Cargo.lock
/spikes/ts/node_modules/
/spikes/ts/dist/
/spikes/**/wip/

# Segreti — nessuna credenziale entra mai nel repo
.env
.env.*
!.env.example
*.key
*.pem
