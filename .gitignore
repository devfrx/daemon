# Operating system
Thumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Scratch and local artefacts
/scratch/
/tmp/
*.log

# Build artefacts of the product
/target/
# ⛔ /Cargo.lock IS NOT ignored, and that is deliberate: gate-deps.sh checks the TRANSITIVE
# dependency graph against the allow-list of ADR-0031. Without a versioned lockfile the
# graph resolves differently on another machine or on another day, and the check would
# measure a graph nobody has approved. The spikes below ignore their own because they are
# throwaway probes; this is the product.

# Build artefacts of the spikes -- the probes are kept, the binaries are not
/spikes/rust/target/
/spikes/rust/Cargo.lock
/spikes/gui-ipc/target/
/spikes/gui-ipc/Cargo.lock
/spikes/gesti/.venv/
/spikes/gesti/relay/target/
/spikes/gesti/relay/Cargo.lock
/spikes/gesti/*.task
/spikes/gesti/*.csv
/spikes/ts/node_modules/
/spikes/ts/dist/
/spikes/**/wip/

# Secrets -- no credential ever enters the repository
.env
.env.*
!.env.example
*.key
*.pem
